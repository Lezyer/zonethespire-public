<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Engine-free mod code compiled directly into the tests (no game assemblies needed). -->
    <Compile Include="..\..\src\ZoneTheSpire\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\src\ZoneTheSpire\ZoneTheSpire.json" Link="ZoneTheSpire.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The mod's text files and the English snapshot they must reproduce. -->
    <None Include="..\..\src\ZoneTheSpire\Localization\**\*.json" Link="Localization\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Localization\snapshot.eng.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
